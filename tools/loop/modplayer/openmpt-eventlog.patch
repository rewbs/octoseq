+// Octoseq instrumentation: the stock player seeds this from the system, which makes
+// random instrument variation (volume/pan/filter swing) differ between renders.
+static mpt::fast_prng OctoseqFixedPrng()
+{
+	std::seed_seq seed{0x0C705E9u, 0x5EEDu};
+	return mpt::fast_prng(seed);
+}
