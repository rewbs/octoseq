--- /dev/null
+++ b/soundlib/OctoseqHook.h
@@ -0,0 +1,62 @@
+/*
+ * OctoseqHook.h
+ * -------------
+ * Purpose: Instrumentation hooks for the Octoseq analysis-accuracy loop.
+ * Notes  : Development-only. Not part of OpenMPT. Applied as a patch by
+ *          octoseq/tools/loop/modplayer/build.sh; never shipped.
+ */
+
+#pragma once
+
+#include <cstdint>
+
+namespace octoseq
+{
+
+// One audible note trigger: a sample (re)started and reached non-zero volume.
+struct NoteEvent
+{
+	uint64_t timeSamples;     // output sample index of the tick on which the sample was (re)started
+	uint64_t audibleSamples;  // output sample index of the first tick with non-zero volume (>= timeSamples)
+	int32_t order, pattern, row, tick;
+	int32_t channel;          // pattern channel, 0-based (background channels report their master channel)
+	int32_t instrument;       // 1-based, 0 = none (sample mode)
+	int32_t sample;           // 1-based
+	int32_t note;             // 1 = C-0, 61 = C-5
+	double playbackRate;      // sample frames consumed per second
+	int32_t realVolume;       // final mix volume, 0..16384
+	int32_t channelVolume;    // 0..256
+	int32_t pan;              // 0..256
+	uint32_t sampleOffset;    // sample frame at which playback started
+	char effectLetter;        // '\0' if none
+	int32_t effectParam;
+	char volLetter;           // '\0' if none
+	int32_t volParam;
+	int32_t cutoff;           // -1 if the resonant filter is off
+	int32_t resonance;
+	bool vibrato, tremolo, arpeggio, portamento, background;
+};
+
+// The start of one pattern row.
+struct RowEvent
+{
+	uint64_t timeSamples;
+	int32_t order, pattern, row;
+	int32_t ticksPerRow;
+	double tempo;             // in the module's own tempo unit (BPM for classic tempo mode)
+	uint32_t samplesPerTick;
+	int32_t rowsPerBeat, rowsPerMeasure;
+	int32_t globalVolume;     // 0..256
+};
+
+struct Hooks
+{
+	void (*note)(const NoteEvent &, void *user) = nullptr;
+	void (*row)(const RowEvent &, void *user) = nullptr;
+	void *user = nullptr;
+};
+
+// Null (the default) disables all instrumentation.
+extern Hooks *g_hooks;
+
+}  // namespace octoseq
